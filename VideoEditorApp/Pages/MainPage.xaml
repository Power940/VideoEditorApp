<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VideoEditorApp.MainPage">

    <Grid RowDefinitions="50, 2*, *" ColumnDefinitions="2*, 5*, 2*">
        
        <Border Grid.Row="1" Stroke="Black">

            <CollectionView x:Name="ImportedMediaCollection_CV" SelectionMode="Single" SelectionChanged="ImportedMediaCollection_CV_SelectionChanged">
                
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        
                        <Grid HeightRequest="80" WidthRequest="120">
                            
                            <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />

                            <BoxView Color="#66000000" />

                            <VerticalStackLayout Padding="4" VerticalOptions="End">
                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" TextColor="White" />
                                <Label Text="{Binding FileDisplayText}" LineBreakMode="TailTruncation" FontSize="12" TextColor="White" />
                            </VerticalStackLayout>
                            
                        </Grid>
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>


        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                Stroke="Black">

            <Grid RowDefinitions="*, 50">
                <toolkit:MediaElement x:Name="MediaPreview_ME" StateChanged="MediaPreview_ME_StateChanged"/>
                <FlexLayout Grid.Row="1" HorizontalOptions="Center" JustifyContent="SpaceEvenly" Wrap="NoWrap">
                    <Button x:Name="ToStart_BTN" Text="|&lt;&lt;" WidthRequest="100" HeightRequest="50" Pressed="ToStart_BTN_Pressed"/>
                    <Button x:Name="Back10_BTN" Text="&lt; 10s" WidthRequest="100" HeightRequest="50" Pressed="Back10_BTN_Pressed"/>
                    <Button x:Name="PlayPause_BTN" Text="Play" WidthRequest="100" HeightRequest="50" Pressed="PlayPause_BTN_Pressed"/>
                    <Button x:Name="Forward10_BTN" Text="10s >" WidthRequest="100" HeightRequest="50" Pressed="Forward10_BTN_Pressed"/>
                    <Button x:Name="ToEnd_BTN" Text=">>|" WidthRequest="100" HeightRequest="50" Pressed="ToEnd_BTN_Pressed"/>
                    <Button x:Name="SpeedChange_BTN" Text="2x" WidthRequest="100" HeightRequest="50" Pressed="SpeedChange_BTN_Pressed"/>
                </FlexLayout>
            </Grid>

        </Border>

        <Border Grid.Row="1" Grid.Column="2"
                Stroke="Black">
        
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Stroke="Black">
            <AbsoluteLayout x:Name="Timeline_AL">
                <AbsoluteLayout x:Name="TimeScale_AL" AbsoluteLayout.LayoutBounds="0.5, 0, 0.95, 0.12"
                                AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                                BackgroundColor="#66666666"
                                SizeChanged="UpdateTimeScale"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.15, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.30, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.45, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.60, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.75, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
                <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.90, 0.95, 0.12"
                         AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional, HeightProportional"
                         BackgroundColor="#44666666"/>
            </AbsoluteLayout>
        </Border>

        <HorizontalStackLayout HorizontalOptions="Start">
            <Button ImageSource="import_one.png" Clicked="Import_BTN_Clicked"/>
            <Button ImageSource="import_multi.png" Clicked="ImportMulti_BTN_Clicked"/>
        </HorizontalStackLayout>
        
    </Grid>

</ContentPage>
